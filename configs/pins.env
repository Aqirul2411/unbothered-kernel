# Pinned inputs. Change these deliberately, never implicitly.
#
# The pinned build script is a fetch machine: besides the kernel it pulls a KSU
# driver, a SUSFS patch set, a KSU setup script and a KPM binary patch from
# branches that move. Every one of those is pinned below by sha, so that "the
# same pins produce the same kernel" is actually true.
#
# Where a sha was not documented by its author, the pin is the commit that was
# HEAD on 2026-10-25 03:44 UTC — the moment the working Image was built from.
# If a first repro build disagrees with configs/marble-working.config on the
# CONFIG_KSU block, these are the numbers to move first.

# --- kernel source ---------------------------------------------------------
# Our own fork, not Arkael's. Three times tonight his repository changed under
# this build: a sibling repo was deleted, then this branch was renamed, then the
# renamed branch got a "Linux 5.10.273" commit that changes only the Makefile.
# A fork is a copy GitHub keeps even if the original is deleted or force-pushed,
# so the pin below can no longer be pulled out from under us.
#
# Verified present in the fork before repointing: 8eab6f338 exists there with
# the same author date and subject. Same tree, different landlord.
#
# Renamed once after that (2026-10-31): arkael-kernel-a12-5.10 -> Unbothered-Build-GKI.
# GitHub redirects the old name, but a pin that relies on a redirect is the same
# mistake as a pin that relies on a branch; the URL below is the real one.
KERNEL_REPO="https://github.com/Aqirul2411/Unbothered-Build-GKI.git"
# Branch history, because this keeps moving: it was bore-bbrv3 until
# 2026-10-31, when it was renamed to bore-bbrv3-5.10 and given one extra commit
# ("Linux 5.10.273", which changes only the Makefile - a relabel, not a merge).
# Our pin is a direct ancestor of the new tip, so the tree is unchanged.
# Our own branch: the pin plus four commits, one per former patch. Patching at
# build time works until an LTS merge moves the code under a patch, and then
# `patch` either fails loudly or applies with fuzz and quietly means something
# else. As commits, the next upgrade is a merge that conflicts visibly.
KERNEL_BRANCH="unbothered-5.10"
# Commit 8eab6f338 = the exact tree behind the working boot image
# ("net: tcp: backport BBRv3 ke android12-5.10 (tanpa hook SUSFS)", 2026-10-25)
# 8eab6f338 + bbrplus + teo + misfit + schedutil, as four commits.
KERNEL_SHA="0140b72c05418ed96bae893732381eabf34d7ac1"
# The 9-character abbreviation that ended up in the working kernel's
# localversion and vermagic. build.sh gets it from `git rev-parse --short HEAD`,
# and git picks the length from the repository's object count -- so the same
# commit can print as 7, 9 or 11 characters depending on how it was cloned.
# That is a silent way for the vermagic to stop matching, so the suffix is
# pinned and the derivation is removed.
# Names the commit actually built. It used to read 8eab6f338, which was true
# while that was HEAD; the tree is now four commits past it, and a version
# string naming a different commit is a lie the phone repeats forever.
# Consequence: the repro identity now reproduces unbothered-5.10, so its
# comparison against the phone's image no longer applies. It did its job long
# before any of these commits existed.
KERNEL_SHORT_SHA="0140b72c0"
# The build clones the branch shallow and then checks out the pin, so the depth
# only has to reach back to the pin. 64 leaves room for months of drift.
KERNEL_CLONE_DEPTH=64

# --- build system ----------------------------------------------------------
BUILD_REPO="https://github.com/Arkael-Dev/build-arkael.git"
BUILD_BRANCH="fix-susfs-510"
BUILD_SHA="f84770a5ab3c1e39eafdb9463a3425766e457816"

# --- root stack -------------------------------------------------------------
# ReSukiSU: Arkael's setup script (its own fork of BakaSU), fetched by build.sh
# from refs/heads/main. We pin both the script and the driver it clones.
BAKASU_SETUP_SHA="8450dd287ef6ee25ca2b6b858b43c9354c73060c"
BAKASU_DRIVER_SHA="d5e9e025b8b49155f8014684d64c91742b465f65"

# SUSFS patch set, gitlab.com/simonpunk/susfs4ksu, branch gki-android12-5.10.
SUSFS_SHA="5419f4ee97cc8bf7ca67a9ff207f39653d7784f4"
SUSFS_CLONE_DEPTH=64

# KPM binary patch applied to the finished Image (KSU=sukisu only),
# Arkael-Dev/SukiSU_patch, branch main, file kpm/patch_linux.
SUKISU_PATCH_SHA="547ae94bcaec53d030398f857950c64662043a5d"

# KernelSU-Next, used only by IDENTITY=own (KSU=yes). build.sh reaches it through
# install_ksu 'pershoot/KernelSU-Next' 'dev-susfs', which curls kernel/setup.sh
# from the branch and then checks that branch out. Same commit for the script and
# the driver it installs, because they are the same repository.
#
# This is the one pin we move on purpose: it tracks the dev-susfs tip, because
# "latest KernelSU-Next" is the point of the own build. Everything else is frozen.
#
# Read this before moving it: this repository is force-pushed often enough to
# keep *_BACKUP-* branches, so a commit on the branch today can be unreachable
# tomorrow. That already happened: 88a9a448 was pinned, got rebased away,
# `git checkout` failed, setup.sh's `|| echo "Checkout default branch"` swallowed
# it, and the build silently used dev instead. A build that looked green did not
# contain the driver it claimed to.
#
# The wrapper now asserts this commit after installing, so the next rebase stops
# the build at three minutes with an explanation instead of shipping a driver
# nobody pinned.
#
# Release tags (v3.4.x) would be more stable, but the manager-list patch build.sh
# applies does not apply to them -- only to the branch tips. Checked, not assumed.
KSUN_SHA="12f302e0ef88c8719960a1428aac7ef26c4b6eef"

# --- packaging --------------------------------------------------------------
# AnyKernel3: the flashable zip. Cannot change the Image, only how it is
# written to the phone, but a moving packaging script is still not a pin.
ANYKERNEL_SHA="26b22266acdc022b65d92c8d0e227be9d81fff44"

# --- source patches applied by the pinned build script ---------------------
# build.sh fetches this one from GitHub with curl and applies it for KVER=5.10.
# A commit URL is immutable in content, so the sha256 is a belt-and-braces
# check rather than a pin: if GitHub ever serves something else, the build stops
# instead of compiling a different camera stack.
INFINIX_CAM_URL="https://github.com/ramabondanp/android_kernel_common-5.10/commit/4fe04b60009e.patch"
INFINIX_CAM_SHA256="727e0117cf342cd78b7486363a5fb66f43ea113504a3bf9cbb4f235aa5cea68e"

# --- toolchain --------------------------------------------------------------
# The toolchain is not fetched by us: build.sh hardcodes this tarball URL, and
# changing it means changing BUILD_SHA. Because CONFIG_CC_VERSION_TEXT is part
# of the embedded config, a silently different toolchain already fails the
# verify step, so these are here to say what should be there, not to enforce it.
EXPECTED_CC_VERSION="Neutron clang version 24.0.0git"
EXPECTED_CLANG_VERSION=240000

# --- what we are reproducing -----------------------------------------------
KVER="5.10"
# Fingerprint of the working kernel on the phone:
EXPECTED_VERMAGIC="5.10.272-Arkael/8eab6f338 SMP preempt mod_unload modversions aarch64"
EXPECTED_LOCALVERSION="-Arkael/8eab6f338"
EXPECTED_LINUX_VERSION="5.10.272"
