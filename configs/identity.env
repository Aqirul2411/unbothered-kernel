# Identity of the kernel we build.
#
# IDENTITY switches between two builds of the same source:
#
#   repro  - build it as "Arkael", the name the working image on the phone uses.
#            Vermagic must come out identical. This is how we prove the pipeline
#            reproduces a kernel we know boots before we change anything.
#
#   own    - build it as "Unbothered". Same tree, same config, different name and
#            different root flavour, therefore a different vermagic. Only run this
#            after `repro` boots.
#
# Override from the environment:  IDENTITY=repro ./scripts/10-build.sh

IDENTITY="${IDENTITY:-own}"

# --- our identity ----------------------------------------------------------
KERNEL_NAME="Unbothered"
# Shows up in uname -a as "<user>@<host>". Change these to your own handle.
KERNEL_USER="unbothered"
KERNEL_HOST="github-actions"

# --- what the working image was built as (do not edit) ---------------------
REPRO_NAME="Arkael"
REPRO_USER="arqzey"
REPRO_HOST="Arch-linux"

# --- build options ---------------------------------------------------------
# vortexcore | arkael
GOVERNOR_CHOICE="${GOVERNOR_CHOICE:-vortexcore}"

# Root flavour is not a free knob per build: it is part of what verify checks.
#
#   repro -> sukisu   The phone's image carries CONFIG_KSU_SAMSUNG_KDP/RKP/DEFEX
#                     and NO_PATCH_TEXT, i.e. ReSukiSU/BakaSU. Building repro with
#                     KernelSU-Next would change the CONFIG_KSU_* block, so the
#                     config diff would stop proving anything.
#   own   -> yes      KernelSU-Next + SUSFS, which is what we want to ship. It is
#                     not a gamble: the Templar image
#                     (configs/templar-working.config, 5.10.271) boots on this
#                     phone with KernelSU-Next + SUSFS, so the stack is proven.
#
# yes = KernelSU-Next + SUSFS, no = vanilla (no root), sukisu = ReSukiSU
case "$IDENTITY" in
  repro) DEFAULT_KSU="sukisu" ;;
  *)     DEFAULT_KSU="yes" ;;
esac
KSU="${KSU:-$DEFAULT_KSU}"
KSU_SUSFS="${KSU_SUSFS:-true}"

# --- the two reference kernels, both of which boot on marble ----------------
#
#   marble-working.config   Arkael  5.10.272   ReSukiSU     + SUSFS   thin LTO
#   templar-working.config  Templar 5.10.271   KernelSU-Next + SUSFS  full LTO
#
# Both were extracted from Images that boot on this phone, so they bracket what
# is safe. The config diff is always against Arkael, because Arkael is our tree;
# the root-flavour check compares against whichever reference matches the KSU
# variant we asked for.
REF_CONFIG="marble-working.config"

case "$IDENTITY:$KSU" in
  repro:*)        KSU_REF_CONFIG="marble-working.config" ;;
  own:yes)        KSU_REF_CONFIG="templar-working.config" ;;
  own:no)         KSU_REF_CONFIG="" ;;
  *)              KSU_REF_CONFIG="" ;;
esac
