# mm: vmscan: bring MGLRU up with core only, walks stay off
#
# Observed on marble: writing 0x7 to /sys/kernel/mm/lru_gen/enabled froze the
# screen. The cause is in lru_gen_change_state(), not in the walks:
#
#   spin_lock_irq(&pgdat->lru_lock);
#   lruvec->lrugen.enabled = enabled;
#   while (!fill_evictable(lruvec)) { unlock; cond_resched(); relock; }
#
# fill_evictable() moves every page currently on the LRU into the generation
# lists, batched, while hammering the node lru_lock. With several GB of cached
# pages across Android's memcgs that is not a deadlock but a stall long enough
# that the UI never updates - which is exactly the frozen screen that was seen,
# with no panic and no reboot. 0x1 is not a smaller test: the expensive part IS
# the core bit.
#
# So enable at boot, when the LRU is nearly empty and the same migration is
# trivial, and bring up only LRU_GEN_CORE. LRU_GEN_MM_WALK and
# LRU_GEN_NONLEAF_YOUNG stay off: they are the invasive half (page table walks
# against vendor arch plumbing), and turning them on later is a static branch,
# not a migration.
#
# Net effect: no expensive transition ever runs, at boot or after.

diff --git a/mm/vmscan.c b/mm/vmscan.c
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -2664,6 +2664,30 @@
 #define get_cap(cap)	static_branch_unlikely(&lru_gen_caps[cap])
 #endif
 
+/*
+ * Boot with the core capability only.
+ *
+ * Enabling MGLRU at runtime on a loaded phone is pathological: change_state()
+ * moves every page already on the LRU into the generation lists while holding
+ * pgdat->lru_lock in batches, so every other CPU that needs that lock stalls
+ * and the screen freezes. At boot the same work is trivial because the lists
+ * are nearly empty.
+ *
+ * The two page-table-walk capabilities are the invasive half - they hook
+ * walk_page_range and depend on arch plumbing that differs on a vendor tree.
+ * Leave both off here; switching them on later through
+ * /sys/kernel/mm/lru_gen/enabled only flips a static branch.
+ */
+static int __init lru_gen_core_only_at_boot(void)
+{
+#ifdef CONFIG_LRU_GEN_ENABLED
+	static_branch_disable(&lru_gen_caps[LRU_GEN_MM_WALK]);
+	static_branch_disable(&lru_gen_caps[LRU_GEN_NONLEAF_YOUNG]);
+#endif
+	return 0;
+}
+late_initcall(lru_gen_core_only_at_boot);
+
 /******************************************************************************
  *                          shorthand helpers
  ******************************************************************************/
